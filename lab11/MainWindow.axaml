<Window xmlns="https://github.com"
        xmlns:x="http://schemas.microsoft.com"
        x:Class="LabApp.MainWindow"
        Title="Сериализация (Linux/Windows)" Width="500" Height="350">
    <StackPanel Margin="20" Spacing="10">
        <!-- Блок Сохранения -->
        <Label Content="Путь для сохранения (Сериализация):" FontWeight="Bold"/>
        <DockPanel>
            <Button Content="Обзор..." Click="BrowseSave_Click" DockPanel.Dock="Right" Margin="5,0,0,0"/>
            <TextBox Name="SavePathBox" Watermark="Выберите файл для записи..."/>
        </DockPanel>
        <Button Content="Сохранить" Click="Serialize_Click" Background="Green" Foreground="White"/>

        <Separator Margin="0,10"/>

        <!-- Блок Загрузки -->
        <Label Content="Путь для загрузки (Десериализация):" FontWeight="Bold"/>
        <DockPanel>
            <Button Content="Обзор..." Click="BrowseOpen_Click" DockPanel.Dock="Right" Margin="5,0,0,0"/>
            <TextBox Name="OpenPathBox" Watermark="Выберите файл для чтения..."/>
        </DockPanel>
        <Button Content="Загрузить" Click="Deserialize_Click" Background="Blue" Foreground="White"/>
    </StackPanel>
</Window>

