<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        x:Class="UI.MainWindow"
        Title="Сериализация (Linux/Windows)" Width="500" Height="350">
    <StackPanel Margin="20" Spacing="10">
        <!-- Блок Сохранения -->
        <Label Content="Путь для сохранения (Сериализация):" FontWeight="Bold"/>
        <DockPanel>
            <Button Name="BrowseSaveBtn" Content="Обзор..." DockPanel.Dock="Right"/>
            <TextBox Name="SavePathBox" Watermark="Выберите файл для записи..."/>
        </DockPanel>
        <Button Name="SerializeButton" Content="Сохранить" />

        <Separator Margin="0,10"/>

        <!-- Блок Загрузки -->
        <Label Content="Путь для загрузки (Десериализация):" FontWeight="Bold"/>
        <DockPanel>
            <Button Name="BrowseSaveButton" Content="Обзор..." DockPanel.Dock="Right"/>
            <TextBox Name="OpenPathBox" Watermark="Выберите файл для чтения..."/>
        </DockPanel>
        <Button Name="DeserializeButton" Content="Загрузить" DockPanel.Dock="Right"/>
    </StackPanel>
</Window>

