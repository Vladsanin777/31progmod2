<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сериализация (WPF)" Height="350" Width="500"
        WindowStartupLocation="CenterScreen">
    
    <StackPanel Margin="20">
        <Label Content="Путь для сохранения (Сериализация):" FontWeight="Bold"/>
        
        <DockPanel LastChildFill="True" Margin="0,5,0,15">
            <Button Name="BrowseSaveBtn" Content="Обзор..." DockPanel.Dock="Right" Width="75" Click="BrowseSaveBtn_Click"/>
            <!-- В WPF нет Watermark, вместо него обычно используют Hint или Label рядом -->
            <TextBox Name="SavePathBox" VerticalContentAlignment="Center"/>
        </DockPanel>
        
        <Button Name="SerializeButton" Content="Сохранить" HorizontalAlignment="Left" Width="100" Click="SerializeButton_Click"/>

        <Separator Margin="0,20"/>

        <Label Content="Путь для загрузки (Десериализация):" FontWeight="Bold"/>
        
        <DockPanel LastChildFill="True" Margin="0,5,0,15">
            <Button Name="BrowseOpenBtn" Content="Обзор..." DockPanel.Dock="Right" Width="75" Click="BrowseOpenBtn_Click"/>
            <TextBox Name="OpenPathBox" VerticalContentAlignment="Center"/>
        </DockPanel>
        
        <Button Name="DeserializeButton" Content="Загрузить" HorizontalAlignment="Left" Width="100" Click="DeserializeButton_Click"/>
    </StackPanel>
</Window>

