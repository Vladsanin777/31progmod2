<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WFP ГОВНО!!! QT СИЛА!!!" Height="350" Width="500"
        Background="#002200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#AAAA00" CornerRadius="5" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#002200"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00AA00"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#AAAA00"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#AAAA00"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00AA00"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="Transparent" 
                                BorderBrush="#AAAA00" 
                                BorderThickness="2,2,2,0" 
                                Padding="10,5">
                            <ContentPresenter x:Name="TextContent"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"/>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TextContent" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextContent" Property="TextElement.FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#AAAA00"/>
        </Style>

        <Style TargetType="StackPanel">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="DockPanel">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Background" Value="#002200"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="#AAAA00" 
                                Height="2" 
                                HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <Label Content="Path serialize" FontWeight="Bold"/>
            
            <DockPanel LastChildFill="True" Margin="0,5,0,15">
                <Button Name="SerializeButton" Content="Serialize" HorizontalAlignment="Left" Width="100" Click="SerializeButton_Click"/>
                <Button Name="BrowseSerializeBtn" Content="Browse" DockPanel.Dock="Right" Width="75" Click="BrowseSerializeBtn_Click"/>
                <TextBox Name="SerializePathBox" VerticalContentAlignment="Center"/>
            </DockPanel>
            

            <Separator Margin="0,20"/>

            <Label Content="Path deseralize" FontWeight="Bold"/>
            
            <DockPanel LastChildFill="True" Margin="0,5,0,15">
                <Button Name="DeserializeButton" Content="Deserialize" HorizontalAlignment="Left" Width="100" Click="DeserializeButton_Click"/>
                <Button Name="BrowseDeserializeBtn" Content="Browse" DockPanel.Dock="Right" Width="75" Click="BrowseDeserializeBtn_Click"/>
                <TextBox Name="DeserializePathBox" VerticalContentAlignment="Center"/>
            </DockPanel>
            

            <Separator Margin="0,20"/>

            <TabControl Margin="0,5,0,15" Name="SerializeTab">
                <TabItem Header="Human">
                    <StackPanel Margin="10">
                        <Label Content="First name" FontWeight="Bold"/>
                        <TextBox Name="FirstNameHuman"/>
                        <Separator Margin="0,10"/>
                        <Label Content="Second name" FontWeight="Bold"/>
                        <TextBox Name="SecondNameHuman"/>
                        <Separator Margin="0,10"/>
                        <Label Content="Surname" FontWeight="Bold"/>
                        <TextBox Name="SurnameHuman"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Student">
                    <StackPanel Margin="10">
                        <Label Content="First name" FontWeight="Bold"/>
                        <TextBox Name="FirstNameStudent"/>
                        <Separator Margin="0,10"/>
                        <Label Content="Second name" FontWeight="Bold"/>
                        <TextBox Name="SecondNameStudent"/>
                        <Separator Margin="0,10"/>
                        <Label Content="Surname" FontWeight="Bold"/>
                        <TextBox Name="SurnameStudent"/>
                        <Separator Margin="0,10"/>
                        <Label Content="Course" FontWeight="Bold"/>
                        <TextBox Name="CourseStudent" PreviewTextInput="NumberBox_PreviewTextInput" />
                        <Separator Margin="0,10"/>
                        <Label Content="Study building" FontWeight="Bold"/>
                        <TextBox Name="StudyBuildingStudent"/>
                        <Separator Margin="0,10"/>
                        <Label Content="Group" FontWeight="Bold"/>
                        <TextBox Name="GroupStudent"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Window>
